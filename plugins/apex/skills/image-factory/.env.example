# Image Factory settings. Copy this file to .env and fill in the key.
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-2.5-sunburst      # or gpt-image-2.5-flare (same price, faster)
# IMAGE_QUALITY=medium                     # low, medium, high, xhigh, max
# IMAGE_WORKERS=3                          # images generated at the same time

# The Shopify login does NOT go here. Put it in .env.<store> (one file per store key), e.g. .env.mystore:
# SHOPIFY_SHOP=your-store
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Keep these lines commented out in .env: active SHOPIFY_ lines here override .env.<store>.

# THEME_DIR=C:\path\to\your\local\theme   # the theme folder Claude Code works in (or setx THEME_DIR)
